<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  The Mac's Finder shows the app's localized name (闲敲棋子 in Chinese)
	  only with this key, and only while CFBundleDisplayName matches the
	  bundle's file name, which PRODUCT_NAME sets.
	-->
	<key>LSHasLocalizedDisplayName</key>
	<true/>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_boardgame._tcp</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Star River Game</string>
			<key>UTTypeIdentifier</key>
			<string>com.chentianren.minixiangqi.game</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mxq</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.minixiangqi.game+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
</dict>
</plist>
