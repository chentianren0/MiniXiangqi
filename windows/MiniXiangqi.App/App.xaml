<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MiniXiangqi.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                One point of the board. The board itself is a single picture —
                a grid, two palaces and up to twenty-four discs, not forty-nine
                views — but a picture has no points a pointer can hit or a
                screen reader can name. These supply both, and they carry no
                visuals of their own for that reason: every mark on the board is
                drawn by the painter beneath them.

                IsTabStop is false deliberately. Playing the board by keyboard
                exists on no platform and is deferred everywhere (issue #80,
                owner decision 2026-07-30), so forty-nine tab stops in front of
                the play controls would be a keyboard affordance leading
                nowhere.
            -->
            <Style x:Key="BoardPointStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                One way to play, on the Play home. A row rather than a
                button-shaped control, because the two modes are a list of things
                to choose between and neither of them is the answer — the tint
                rule names them explicitly as not among the things that may be
                tinted. What says where choosing one goes is the chevron the
                window puts on it, and where it goes is a page rather than a
                game: a game is created by 开始对局 on the page it opens, and by
                nothing else.
            -->
            <Style x:Key="ModeEntryStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!--
                One row of the Settings destination: a label on the left, the
                control that changes it on the right, inside the card its group
                is drawn as. The minimum height is what keeps a row carrying a
                switch and a row carrying a pop-up the same height, so a group
                reads as a list rather than as controls of assorted sizes; the
                padding is the mode entry's, because both are rows inside the
                same kind of card and there is no reason for two answers.

                Only the geometry is here. What the columns are is each row's,
                because a style cannot carry column definitions, and every row on
                that screen has the same two.
            -->
            <Style x:Key="SettingsRowStyle" TargetType="Grid">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinHeight" Value="60" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
