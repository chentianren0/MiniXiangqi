<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MiniXiangqi.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                One point of the board. The board itself is a single picture —
                a grid, two palaces and up to twenty-four discs, not forty-nine
                views — but a picture has no points a pointer can hit or a
                screen reader can name. These supply both, and they carry no
                visuals of their own for that reason: every mark on the board is
                drawn by the painter beneath them.

                IsTabStop is false deliberately. Playing the board by keyboard
                exists on no platform and is deferred everywhere (issue #80,
                owner decision 2026-07-30), so forty-nine tab stops in front of
                the play controls would be a keyboard affordance leading
                nowhere.
            -->
            <Style x:Key="BoardPointStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
