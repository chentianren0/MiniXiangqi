<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MiniXiangqi.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Three destinations, and the pages inside each of them.

        **Play** has three pages: the home where what to play is chosen, each
        mode's pre-start state, and the board. **History** has two: the list of
        filed games, and one record's read-only step-through viewer. **Settings**
        has one and needs no more. One page is visible at a time, and the
        destination's own object is what says which — the page is drawn rather
        than pushed, so there is no navigation history to keep in step with the
        state.

        Over them sits the one navigation row: the back control, which appears
        on the pages that have somewhere to go back to and names the page it
        returns to, and the destination's own title, which its pages share.

        The container around all three is a NavigationView, which is this
        platform's own: docs/interaction-design.md § Layout shapes fixes that
        "navigation uses one adaptive container, and the container is the
        platform's own rather than a presentation the app selects", so the
        display mode is left at Auto and the app decides none of it.
        **IsSettingsVisible is now on**, which is the container's own settings
        item — the platform's gear, in the platform's place at the foot of the
        pane, reached the platform's way. Its word is the one thing the app
        supplies, from `nav.settings`, because that row is the string of record
        for this destination's name and a framework's own word for it would be a
        second source of truth.

        Nothing resident intersects the board block on any page that has a board:
        the panel sits beside it and the air around the board is an allowance
        taken off the space the board is fitted into. The result notice is a
        transient, and it may stand in front of the board precisely because the
        player can put it away.
    -->

    <NavigationView x:Name="Shell"
                    IsSettingsVisible="True"
                    IsBackButtonVisible="Collapsed"
                    SelectionChanged="OnDestinationChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="DestinationPlay" Tag="play">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7FC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="DestinationHistory" Tag="history">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The navigation row. -->
        <Grid x:Name="NavigationBar" Padding="8,4" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="Back"
                    Click="OnBack"
                    Visibility="Collapsed"
                    Width="40"
                    Height="36"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="&#xE72B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    AutomationProperties.AutomationId="play-back" />
            <TextBlock x:Name="PageTitle"
                       Grid.Column="1"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0" />
        </Grid>

        <!-- ============================================================= -->
        <!-- The Play home: an independent page for choosing what to play,  -->
        <!-- and there is no board anywhere on it.                          -->
        <!-- ============================================================= -->
        <ScrollViewer x:Name="HomePage" Grid.Row="1" Visibility="Collapsed">
            <StackPanel MaxWidth="560"
                        HorizontalAlignment="Stretch"
                        Padding="24,16,24,24"
                        Spacing="20">

                <!--
                    The active game: what it is, and the way back into it. The
                    header is the same 当前对局 the save-and-continue
                    confirmation puts over the same line.
                -->
                <StackPanel x:Name="CurrentGame" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="CurrentGameHeader"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Padding="16"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <!-- Every token on the line is content the contract
                                 asks for, so it wraps rather than truncating. -->
                            <TextBlock x:Name="CurrentGameLine"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="home-current-game" />
                            <!-- The one obvious next action on this page while a
                                 game is going, and therefore the one thing on it
                                 the tint rule allows. -->
                            <Button x:Name="ResumeGame"
                                    Click="OnResume"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="home-resume" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--
                    The game's ways to play. One section, and it carries no
                    header while there is one game: a header naming the only game
                    on a screen that is only that game labels the obvious. A
                    second game would be a second section beside this one rather
                    than a rearrangement of it.
                -->
                <Border CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <Button x:Name="ModeHumanVersusAi"
                                Click="OnChooseHumanVersusAi"
                                Style="{StaticResource ModeEntryStyle}"
                                AutomationProperties.AutomationId="mode-human-versus-ai" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button x:Name="ModeFreePlay"
                                Click="OnChooseFreePlay"
                                Style="{StaticResource ModeEntryStyle}"
                                AutomationProperties.AutomationId="mode-free-play" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================= -->
        <!-- The pre-start state: the initial board as a noninteractive     -->
        <!-- preview, and the controls this game is configured with.        -->
        <!-- ============================================================= -->
        <Grid x:Name="SetupPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PreviewHost" Padding="24" SizeChanged="OnPreviewHostSizeChanged" />

            <Grid x:Name="SetupPanel"
                  Grid.Column="1"
                  Width="260"
                  Padding="16"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderThickness="1,0,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <StackPanel Spacing="14" VerticalAlignment="Top">

                    <!-- 人机对弈's 本局设置 group. Absent in Free Play, which
                         has no side selector, no AI controls and no pre-start
                         flip control. -->
                    <StackPanel x:Name="ThisGame" Spacing="14">
                        <TextBlock x:Name="ThisGameHeader"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   AutomationProperties.AutomationId="setup-header" />

                        <RadioButtons x:Name="FirstMover"
                                      MaxColumns="1"
                                      SelectionChanged="OnFirstMoverChanged"
                                      AutomationProperties.AutomationId="setup-first-mover">
                            <RadioButton x:Name="FirstMoverHuman" />
                            <RadioButton x:Name="FirstMoverAi" />
                            <RadioButton x:Name="FirstMoverRandom" />
                        </RadioButtons>

                        <ComboBox x:Name="Level"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnLevelChanged"
                                  AutomationProperties.AutomationId="setup-ai-level">
                            <ComboBoxItem x:Name="LevelFast" />
                            <ComboBoxItem x:Name="LevelStandard" />
                            <ComboBoxItem x:Name="LevelDeep" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Free Play's one line, which says what Free Play is. -->
                    <TextBlock x:Name="FreePlayExplanation"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               AutomationProperties.AutomationId="setup-explanation" />

                    <!-- The one obvious next action on this page, and therefore
                         the one thing on it the tint rule allows. It cannot be
                         invoked again while creation is in progress, and a
                         failure re-enables it with the draft untouched. -->
                    <Button x:Name="StartGame"
                            Click="OnStartGame"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="setup-start" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================================================= -->
        <!-- The board.                                                     -->
        <!-- ============================================================= -->
        <Grid x:Name="BoardPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The board, centred in whatever the panel leaves. -->
            <Grid x:Name="BoardHost" Padding="24" SizeChanged="OnBoardHostSizeChanged" />

            <!-- The result notice: a transient over the board, dismissible. -->
            <Border x:Name="Notice"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320"
                    MaxWidth="420"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock x:Name="NoticeTitle"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="NoticeClose"
                                Click="OnDismissNotice"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Padding="4"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="&#xE711;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </Grid>
                    <TextBlock x:Name="NoticeReason"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <!--
                        The default action leads. On Apple platforms it trails,
                        which is where that platform puts one; Fluent puts the
                        primary first, and the contract's rule is the ordering
                        decision itself — 保存 is the default and the only tinted
                        element on the screen — rather than which end of the row it
                        sits at. So the platform's own order stands.
                    -->
                    <StackPanel x:Name="NoticeActions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button x:Name="NoticePrimary" Click="OnNoticePrimary" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="NoticeSecondary" Click="OnNoticeSecondary" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The panel. Its sections begin on one edge, 16 in from its own. -->
            <Grid x:Name="Panel"
                  Grid.Column="1"
                  Width="260"
                  Padding="16"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderThickness="1,0,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Turn status: one coherent description of the current play state. -->
                <StackPanel Spacing="6" Margin="0,0,0,16">
                    <StackPanel x:Name="TurnStatus"
                                Spacing="6"
                                AutomationProperties.AutomationId="turn-status">
                        <TextBlock x:Name="StatusPrimary"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusSecondary"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <ProgressRing x:Name="Thinking"
                                          Width="16"
                                          Height="16"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          AutomationProperties.AutomationId="ai-thinking" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The stalled slot, outside the combined element above,
                         because a control folded into one is a control a screen
                         reader cannot reach. -->
                    <StackPanel x:Name="Stalled"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="StalledText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="ai-stalled" />
                        <HyperlinkButton x:Name="StalledRetry"
                                         Padding="0"
                                         Click="OnRetryEngine"
                                         AutomationProperties.AutomationId="ai-retry" />
                    </StackPanel>

                    <!-- The save-failure capsule, anchored to the turn status. -->
                    <Border x:Name="SaveFailure"
                            Visibility="Collapsed"
                            Padding="8,4"
                            CornerRadius="4"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                        <TextBlock x:Name="SaveFailureText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="save-failed" />
                    </Border>
                </StackPanel>

                <!-- The move record: the core's own canonical coordinate text. -->
                <ScrollViewer x:Name="RecordScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RecordRows" Spacing="2" AutomationProperties.AutomationId="move-record" />
                </ScrollViewer>

                <!-- The play-control cluster. -->
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                    <Button x:Name="Undo"
                            HorizontalAlignment="Stretch"
                            Click="OnUndo"
                            AutomationProperties.AutomationId="control-undo" />
                    <Button x:Name="Middle"
                            HorizontalAlignment="Stretch"
                            Click="OnMiddle"
                            AutomationProperties.AutomationId="control-middle" />
                    <Button x:Name="Trailing"
                            HorizontalAlignment="Stretch"
                            Click="OnTrailing"
                            AutomationProperties.AutomationId="control-trailing" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================================================= -->
        <!-- History: the list of filed games, in the core's own order.     -->
        <!-- ============================================================= -->
        <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                导入… lives on this destination and nowhere else, because this is
                the screen the result lands on. It is above the empty state
                either way: the empty state says what it says and offers nothing
                else to do.
            -->
            <StackPanel Orientation="Horizontal"
                        Padding="24,4,24,8"
                        HorizontalAlignment="Right">
                <Button x:Name="Import"
                        Click="OnImport"
                        AutomationProperties.AutomationId="history-import" />
            </StackPanel>

            <ScrollViewer x:Name="HistoryScroller" Grid.Row="1" Padding="24,0,24,24">
                <StackPanel MaxWidth="640" HorizontalAlignment="Stretch" Spacing="8">

                    <!--
                        Pinned records appear before unpinned records, and the two
                        groups are rendered as two sections rather than as a
                        per-row badge: pinned-ness is ordering rather than
                        decoration. With nothing pinned there is one unheaded
                        section and the list reads as a plain list of games.

                        Each list scrolls with the page rather than inside itself,
                        so the two sections read as one list.
                    -->
                    <TextBlock x:Name="PinnedHeader"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                    <ListView x:Name="PinnedRecords"
                              Visibility="Collapsed"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ItemClick="OnRecordClicked"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="history-pinned" />

                    <TextBlock x:Name="OthersHeader"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                    <ListView x:Name="OtherRecords"
                              Visibility="Collapsed"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ItemClick="OnRecordClicked"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="history-others" />

                    <!-- An empty History says so quietly, and offers nothing
                         else to do. -->
                    <StackPanel x:Name="HistoryEmpty"
                                Visibility="Collapsed"
                                Spacing="6"
                                Padding="0,64,0,0"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="HistoryEmptyTitle"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="history-empty" />
                        <TextBlock x:Name="HistoryEmptyDescription"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================= -->
        <!-- The step-through viewer: one filed game, read-only.            -->
        <!-- ============================================================= -->
        <Grid x:Name="ViewerPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ReplayHost" Padding="24" SizeChanged="OnReplayHostSizeChanged" />

            <Grid Grid.Column="1"
                  Width="260"
                  Padding="16"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderThickness="1,0,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Progress through the game as shown ply / recorded plies, and
                    the record's own metadata — the same line its History row
                    carries. There is no side-to-move line: a finished game is
                    not anybody's turn.
                -->
                <StackPanel Spacing="6" Margin="0,0,0,16">
                    <TextBlock x:Name="ReplayProgress"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.AutomationId="replay-progress" />
                    <TextBlock x:Name="ReplayMetadata"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="replay-metadata" />
                </StackPanel>

                <!-- The move record, and the move it is showing. -->
                <ScrollViewer x:Name="ReplayRecordScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ReplayRecordRows"
                                Spacing="2"
                                AutomationProperties.AutomationId="replay-record" />
                </ScrollViewer>

                <!--
                    The transport. Four controls rather than the accepted five:
                    issue #80 trims Windows replay to a step-through viewer, so
                    there is no autoplay and therefore no pause. They are
                    icon-only and carry their words as accessibility labels and
                    tooltips — the end controls take the media transport's own
                    symbols and the single steps take chevrons, because a step is
                    not a scan.
                -->
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center">
                        <Button x:Name="ReplayFirst"
                                Click="OnReplayFirst"
                                Content="&#xE892;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                AutomationProperties.AutomationId="replay-first" />
                        <Button x:Name="ReplayPrevious"
                                Click="OnReplayPrevious"
                                Content="&#xE76B;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                AutomationProperties.AutomationId="replay-previous" />
                        <Button x:Name="ReplayNext"
                                Click="OnReplayNext"
                                Content="&#xE76C;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                AutomationProperties.AutomationId="replay-next" />
                        <Button x:Name="ReplayLast"
                                Click="OnReplayLast"
                                Content="&#xE893;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                AutomationProperties.AutomationId="replay-last" />
                    </StackPanel>

                    <!-- The accepted history orientation control, which replay
                         keeps. -->
                    <Button x:Name="ReplayFlip"
                            HorizontalAlignment="Stretch"
                            Click="OnReplayFlip"
                            AutomationProperties.AutomationId="replay-flip" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================================================= -->
        <!-- Settings: the preferences the app keeps, and nothing else.     -->
        <!-- ============================================================= -->
        <!--
            Three groups, in the Mac's own order, and the Fluent adaptation is
            one rule applied three times: **a group is a card**. The Mac draws
            these as sections of a grouped Form, which supplies a header above
            and a footer below for free; Windows has no grouped Form, and its own
            settings idiom is a caption-weight header, a card carrying the rows,
            and a caption beneath. The mapping is therefore exact rather than
            approximate — one Form section becomes one header, one card, one
            footer — and the rows inside a card are divided by the same hairline
            the Play home already puts between its two mode entries, so the two
            screens are one app.

            The Community Toolkit's SettingsCard is the packaged form of exactly
            this and was declined: it is a dependency for four rows, and the
            vocabulary it would bring — the card fill, the card stroke, the
            divider, the caption-secondary footer — is already in this file,
            drawn from the same theme resources the toolkit itself uses.

            **What is not here is recorded scope, not a gap.** The Mac's fourth
            group, 棋盘, is absent with both of its rows; so is 触感 from the
            feedback group. Issue #80's owner-decided trim and the contract's own
            hardware rule are why, and MiniXiangqi.Play's SettingsScreen carries
            the reasoning. **The two footers are both here**, which is the
            accepted "there are two footers on the screen, and only two"
            surviving the trim rather than being restated by it: an absent row
            explains itself by not being there, so nothing needed a third.
        -->
        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
            <StackPanel MaxWidth="640"
                        HorizontalAlignment="Stretch"
                        Padding="24,16,24,24"
                        Spacing="20">

                <!-- 人机对弈默认设置: headed and footed, because its two values
                     need saying what they are for. They initialize the next
                     game's setup and never reach the game already on the
                     board. -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DefaultsHeader"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DefaultFirstMoverLabel"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="DefaultFirstMover"
                                          Grid.Column="1"
                                          MinWidth="150"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnDefaultFirstMoverChanged"
                                          AutomationProperties.AutomationId="settings-first-mover">
                                    <ComboBoxItem x:Name="DefaultFirstMoverHuman" />
                                    <ComboBoxItem x:Name="DefaultFirstMoverAi" />
                                    <ComboBoxItem x:Name="DefaultFirstMoverRandom" />
                                </ComboBox>
                            </Grid>

                            <Rectangle Height="1"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DefaultAiLevelLabel"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="DefaultAiLevel"
                                          Grid.Column="1"
                                          MinWidth="150"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnDefaultAiLevelChanged"
                                          AutomationProperties.AutomationId="settings-ai-level">
                                    <ComboBoxItem x:Name="DefaultLevelFast" />
                                    <ComboBoxItem x:Name="DefaultLevelStandard" />
                                    <ComboBoxItem x:Name="DefaultLevelDeep" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="DefaultsFooter"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="settings-defaults-footer" />
                </StackPanel>

                <!-- 声音: its own group, with no header and no footer. On the Mac
                     it stands beside 触感 under no header; here it stands alone
                     under no header, and means exactly what it meant there. -->
                <Border CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SoundLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <!--
                            OnContent and OffContent are emptied and the switch's
                            reserved width with them. A bare switch is what
                            Windows 11's own Settings shows, and the words it
                            would otherwise carry are the framework's rather than
                            docs/copy.md's — copy on a control that this
                            repository's string of record does not own. Narrator
                            is unaffected: a toggle reports its state through the
                            toggle pattern, in the screen reader's own words,
                            whatever content it draws.
                        -->
                        <ToggleSwitch x:Name="Sound"
                                      Grid.Column="1"
                                      MinWidth="0"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"
                                      Toggled="OnSoundToggled"
                                      AutomationProperties.AutomationId="settings-sound" />
                    </Grid>
                </Border>

                <!-- 删除前确认: a group of its own so that its footer is
                     unmistakably about it. Turning it off makes a deletion
                     immediate, and a deletion cannot be undone. -->
                <StackPanel Spacing="8">
                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ConfirmDeleteLabel"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="ConfirmDelete"
                                          Grid.Column="1"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          Toggled="OnConfirmDeleteToggled"
                                          AutomationProperties.AutomationId="settings-confirm-delete" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ConfirmDeleteFooter"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="settings-confirm-delete-footer" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- What is shown instead when the core, the game, or the library did
             not start or load. -->
        <StackPanel x:Name="Failure"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Padding="32"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <TextBlock x:Name="FailureTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="FailureDetail"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontFamily="Consolas"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
    </NavigationView>
</Window>
