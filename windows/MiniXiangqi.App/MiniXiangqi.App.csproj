<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows frontend's first window: WinUI 3 over the Windows App SDK,
    unpackaged. It shows the same readback the smoke harness prints, from the
    same core, so that the interface is proved in a process that also runs a
    UI framework.

    Unpackaged and self-contained, which is now the shipped shape rather than a
    convenience: WindowsPackageType None because the accepted MVP distribution
    is a zip somebody unpacks and runs (issue #80, owner decision, 2026-07-30 —
    MSIX and its signing story are the post-MVP upgrade), and
    WindowsAppSDKSelfContained so that a machine which has never installed the
    Windows App Runtime can run what it unpacked. windows/package-zip.ps1
    publishes this project self-contained on top of both, and
    pinned-inputs.json's Windows entry records what that build measured.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>MiniXiangqi.App</RootNamespace>
    <AssemblyName>MiniXiangqi.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>$(MxqRuntimeIdentifier)</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniXiangqi.Core\MiniXiangqi.Core.csproj" />
    <ProjectReference Include="..\MiniXiangqi.Play\MiniXiangqi.Play.csproj" />
    <ProjectReference Include="..\MiniXiangqi.Board\MiniXiangqi.Board.csproj" />
  </ItemGroup>

  <Import Project="..\CoreArtifacts.targets" />

</Project>
