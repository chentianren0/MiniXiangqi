<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The play screen, minus the window: the board's vocabulary and geometry, the
    accepted piece style's values, the scene a painter draws, the session logic
    that turns clicks into core calls, and the string table.

    It references no UI framework at all, which is the point. A WinUI 3 process
    cannot be launched over SSH, so everything above the core would otherwise be
    unrunnable on the only Windows machine this project has; with the logic
    here, MiniXiangqi.Smoke drives whole games through the real screen logic
    headlessly, and only the XAML is left to a screen.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MiniXiangqi.Play</RootNamespace>
    <AssemblyName>MiniXiangqi.Play</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniXiangqi.Core\MiniXiangqi.Core.csproj" />
  </ItemGroup>

  <!--
    The board's four voices. They are the Apple app's own samples, generated by
    apple/Sounds/generate.py and copied here byte for byte; BoardSoundAssets.cs
    carries the provenance and the reason they are copied rather than referenced
    across the two frontends' trees, and the Windows CI job compares the hashes
    so the two bundles cannot drift apart quietly.

    They ride with this project rather than with MiniXiangqi.App because both
    executables want them: the app plays them, and the headless harness states
    that all four reached the output directory — which is the check that catches
    a sample falling out of the build, since a board with no samples is silent
    rather than broken and sound is never the only way anything is conveyed.
  -->
  <ItemGroup>
    <Content Include="Sounds\*.wav">
      <Link>sounds\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
