<Project>

  <!--
    Settings shared by every project under windows/. Windows 11 on x64 is the
    target (owner decisions, 2026-07-30, recorded in pinned-inputs.json), and
    .NET 10 is the SDK the machine that builds this carries.

    AllowUnsafeBlocks is not a convenience: the core's C interface is pointers
    and fixed-capacity buffers, and docs/core-interface.md's binding rule is
    that every struct crosses blittable. Marshalling them would mean copying
    them.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>

    <!--
      Globalization is on. It was off in the walking skeleton, which showed one
      screen of ASCII diagnostics and needed none of it; the play screen does.
      docs/interaction-design.md's localization rule is that the app follows the
      language the operating system selects for it, with no interface-language
      control of its own, and under InvariantGlobalization every culture is the
      invariant one — so the app would answer in English on a Chinese system and
      the rule would be silently unimplementable.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Where windows/build-core-dll.ps1 leaves mxqcore.dll and the staged
         asset directory. Executables copy both beside themselves. -->
    <MxqArtifactsDir>$(MSBuildThisFileDirectory)artifacts\</MxqArtifactsDir>
  </PropertyGroup>

</Project>
