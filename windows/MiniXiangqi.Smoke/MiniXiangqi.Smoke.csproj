<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The headless proof that the C# frontend really talks to the real core, and
    that the play screen really plays. It has no window and no framework beyond
    the runtime, so it runs over SSH on a machine nobody is logged into, which
    is where this project's Windows evidence is produced.

    It references MiniXiangqi.Play but nothing that draws: the play screen's
    logic is a plain object, so a whole game against the AI can be played
    through the same session the window drives, headlessly. It deliberately does
    not reference the Windows App SDK, which would put a bootstrapper in front
    of Main on a machine with no desktop.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MiniXiangqi.Smoke</RootNamespace>
    <AssemblyName>MiniXiangqi.Smoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniXiangqi.Core\MiniXiangqi.Core.csproj" />
    <ProjectReference Include="..\MiniXiangqi.Play\MiniXiangqi.Play.csproj" />
  </ItemGroup>

  <Import Project="..\CoreArtifacts.targets" />

</Project>
