<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS signs with this file. iPhone and iPad sign with
  MiniXiangqi-iOS.entitlements — this file plus Wi-Fi Aware, less
  com.apple.security.network.client, whose own comment below says why it stays
  here. So a key added here is added there too, unless it is one the Mac's
  sandbox alone gives meaning to.

  Neither file writes com.apple.security.app-sandbox, and neither needs to: on
  the Mac the project's ENABLE_APP_SANDBOX is the switch, and iPhone and iPad
  are sandboxed by the system with no entitlement at all.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.game-center</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.security.hardened-process</key>
	<true/>
	<key>com.apple.security.hardened-process.checked-allocations</key>
	<true/>
	<key>com.apple.security.hardened-process.dyld-ro</key>
	<true/>
	<key>com.apple.security.hardened-process.enhanced-security-version-string</key>
	<string>2</string>
	<key>com.apple.security.hardened-process.hardened-heap</key>
	<true/>
	<key>com.apple.security.hardened-process.platform-restrictions-string</key>
	<string>2</string>
	<!--
	  Game Center reaches Apple's servers and the other player from inside the
	  Mac's sandbox. iPhone and iPad have no such gate, which is why this one key
	  does not travel to the file beside it.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
