{
  "sourceLanguage": "en",
  "strings": {
    "about.build": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建版本"
          }
        }
      }
    },
    "about.license": {
      "comment": "The row that opens the licence, and the title of the page that shows it. The licence text itself is the GPL's own document and is not copy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "License"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许可证"
          }
        }
      }
    },
    "about.license.statement": {
      "comment": "The licence is named by its own name in both languages, like WXF: it is the name of a document, not a description of one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini Xiangqi is free software, released under the GNU General Public License v3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini Xiangqi 是自由软件，依据 GNU General Public License v3 发布。"
          }
        }
      }
    },
    "about.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "about.source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源代码"
          }
        }
      }
    },
    "about.title": {
      "comment": "The About page inside Settings, and the row that reaches it: one word for one thing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "about.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "alert.aiUnavailable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough memory available. Please close some other apps, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前可用内存不足。请尝试关闭一些其他 App，然后重试。"
          }
        }
      }
    },
    "alert.aiUnavailable.resumeMessage": {
      "comment": "The mid-game form: the same situation and the same title, plus the one guarantee the pre-start case has no need of.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough memory available. The game is saved and you can continue later. Please close some other apps, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前可用内存不足。对局已保存，可以稍后继续。请尝试关闭一些其他 App，然后重试。"
          }
        }
      }
    },
    "alert.aiUnavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Start the AI Opponent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动 AI 对手"
          }
        }
      }
    },
    "alert.claimDraw.message": {
      "comment": "See alert.claimDraw.title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can end the game as a draw."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以和棋结束。"
          }
        }
      }
    },
    "alert.claimDraw.title": {
      "comment": "With alert.claimDraw.message this is one accepted sentence, split into the two alert roles. The halves must not be recombined into a single title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This position has occurred three times."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局面已三次重复"
          }
        }
      }
    },
    "alert.deleteFailed.message": {
      "comment": "The same shape as alert.saveFailed.message: could not do it, nothing changed, try again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game is still in History. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这盘棋仍然保留在历史里。请重试。"
          }
        }
      }
    },
    "alert.deleteFailed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Delete This Game"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除这盘棋"
          }
        }
      }
    },
    "alert.deleteGame.message": {
      "comment": "Recovered rather than undone: the app has a visible Undo control that means something else, and there is no deletion undo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game can't be recovered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后无法恢复。"
          }
        }
      }
    },
    "alert.deleteGame.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this game?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这盘棋？"
          }
        }
      }
    },
    "alert.gameNotStarted.message": {
      "comment": "A creation that could not be persisted. It cannot say 当前对局仍然保留, because there is no current game to keep.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving the new game failed. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存这盘新对局时出错。请重试。"
          }
        }
      }
    },
    "alert.gameNotStarted.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Start the Game"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始对局"
          }
        }
      }
    },
    "alert.importConflict.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is the same game as one in History, but its contents differ. History is unchanged. To use this file, delete that game from History first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它和历史中的一盘棋是同一局，但内容不同。历史没有改变。如果要用这个文件，请先删除历史中的那一盘。"
          }
        }
      }
    },
    "alert.importConflict.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This File Conflicts with a Game in History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件和历史中的一盘棋冲突"
          }
        }
      }
    },
    "alert.importDamagedRecord.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The record in History matching this file is damaged, so it can't be compared or imported. To use this file, delete that game from History first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件对应的历史记录已损坏，无法比较或导入。如果要用这个文件，请先删除历史中的那一盘。"
          }
        }
      }
    },
    "alert.importDamagedRecord.title": {
      "comment": "The one import answer that is about the library rather than about the file, and the only one that may say damaged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Game in History Is Damaged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史中有一盘损坏的棋"
          }
        }
      }
    },
    "alert.importDuplicate.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game in this file is identical to one already in History, so it wasn't added again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件里的对局和历史中的一盘完全相同，所以没有重复添加。"
          }
        }
      }
    },
    "alert.importDuplicate.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Game Is Already in History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这盘棋已经在历史里"
          }
        }
      }
    },
    "alert.importNewerVersion.message": {
      "comment": "The one message the data contract requires to be distinct, and never to be presented as corruption: no word here means damaged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version can't read it. Update Mini Xiangqi and try again. History is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本无法读取它。请更新 Mini Xiangqi 后再试。历史没有改变。"
          }
        }
      }
    },
    "alert.importNewerVersion.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This File Was Created by a Newer Version of Mini Xiangqi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件由更新版本的 Mini Xiangqi 创建"
          }
        }
      }
    },
    "alert.importSaveFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game file is fine, but saving it to History failed. History is unchanged. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对局文件没有问题，但保存到历史时出错。历史没有改变。请重试。"
          }
        }
      }
    },
    "alert.importSaveFailed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Save the Imported Game"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存导入的对局"
          }
        }
      }
    },
    "alert.importUnreadable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file's contents are invalid or too large to import. History is unchanged. Check that the file is complete, or ask for a new copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件的内容无效或过大，无法导入。历史没有改变。请确认文件完整，或者向对方要一份新的。"
          }
        }
      }
    },
    "alert.importUnreadable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't Read This Game File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这个对局文件"
          }
        }
      }
    },
    "alert.nearbyDeclined.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Game Didn't Start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对局没有开始"
          }
        }
      }
    },
    "alert.nearbyInvite.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game starts as soon as you accept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受后立即开始对局。"
          }
        }
      }
    },
    "alert.nearbyInvite.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone Wants to Play"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方邀请你对弈"
          }
        }
      }
    },
    "alert.newGame.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game will be saved to History as it is now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这盘对局将按当前状态保存到历史。"
          }
        }
      }
    },
    "alert.newGame.metadataHeader": {
      "comment": "The header over the active game’s metadata: on the Play home’s card, and in the save-and-continue confirmation, which are the same words over the same line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Game"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前对局"
          }
        }
      }
    },
    "alert.newGame.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new game?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始新对局？"
          }
        }
      }
    },
    "alert.resign.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resigning records this game as your loss."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认输后本局将记为你落败。"
          }
        }
      }
    },
    "alert.resign.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resign?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认输？"
          }
        }
      }
    },
    "alert.saveFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current game is unchanged. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前对局仍然保留。请重试。"
          }
        }
      }
    },
    "alert.saveFailed.title": {
      "extractionState": "manual",
      "localizations": {
