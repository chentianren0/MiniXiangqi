    "metadata.imported": {
      "comment": "The imported marker, a word rather than a glyph, joined to the row's date by metadata.join.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入"
          }
        }
      }
    },
    "metadata.join": {
      "comment": "Applied repeatedly to compose a metadata line. The middot and the spaces around it are the same in both languages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "metadata.moveCount": {
      "comment": "A plural pattern in English and a literal in Chinese: the Chinese measure word is invariant and the English noun is not.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld move"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld moves"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 步"
          }
        }
      }
    },
