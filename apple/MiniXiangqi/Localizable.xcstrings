    },
    "piece.cannon": {
      "comment": "The piece's name where words are used rather than the board's own glyph. English names it by its piece name; Chinese names it by the character the piece carries, which is game content, is never translated, and so passes through as the argument rather than being written here.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
