    "metadata.join": {
      "comment": "Applied repeatedly to compose a metadata line. The middot and the spaces around it are the same in both languages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "metadata.moveCount": {
      "comment": "A plural pattern in English and a literal in Chinese: the Chinese measure word is invariant and the English noun is not.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld move"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld moves"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 步"
          }
        }
      }
    },
    "moveList.rowNumber": {
      "comment": "A move-list row number: numerals and a full stop. No word is translated.",
