 * describes one is the version of the core that wrote it. */
#define MXQ_BUILD_APP_VERSION "@PROJECT_VERSION@"

/* pinned-inputs.json: fork.revision */
#define MXQ_BUILD_FORK_REVISION "@MXQ_BUILD_FORK_REVISION@"

/* pinned-inputs.json: variant.id — the variant the app plays, and the one the
