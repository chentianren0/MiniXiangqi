/* network.xiangqi.sha256 */
#define MXQ_BUILD_XIANGQI_NNUE_SHA256 "@MXQ_BUILD_XIANGQI_NNUE_SHA256@"

/* network.xiangqi.filename */
#define MXQ_BUILD_XIANGQI_NNUE_FILENAME "@MXQ_BUILD_XIANGQI_NNUE_FILENAME@"

/* network.xiangqi.byte_length */
#define MXQ_BUILD_XIANGQI_NNUE_BYTE_LENGTH @MXQ_BUILD_XIANGQI_NNUE_BYTE_LENGTH@u

