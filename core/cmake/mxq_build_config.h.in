#define MXQ_BUILD_XIANGQI_VARIANT_ID "@MXQ_BUILD_XIANGQI_VARIANT_ID@"

/* One network per variant, from pinned-inputs.json's network.<variant> entries.
 * A basename must begin with the identifier of the variant it is loaded for or
 * the engine silently disables NNUE, so these names are not decoration. */

/* network.<variant.id>.sha256 */
