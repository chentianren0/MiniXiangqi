/* pinned-inputs.json: gomoku_fork.revision */
#define MXQ_BUILD_GOMOKU_FORK_REVISION "@MXQ_BUILD_GOMOKU_FORK_REVISION@"

/* The weights, from pinned-inputs.json's gomoku_network.<rules>.files entries.
 * Unlike the first engine's, these names are not load-bearing to the engine —
 * it binds a weight file to a game by the rule and board-size masks in the
 * file's own header, not by its name — so a name here is only how the bridge
 * finds the bytes it then verifies. Freestyle has one file, which serves both
 * sides; renju has one per side, because the forbidden-move rules apply to
 * Black alone and the two sides are trained apart. */

/* gomoku_network.gomoku-15.files[0] — role "black-and-white" */
#define MXQ_BUILD_GOMOKU_NNUE_FILENAME "@MXQ_BUILD_GOMOKU_NNUE_FILENAME@"
