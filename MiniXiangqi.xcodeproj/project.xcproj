{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "core",
    },
  ],
  "files": [
    { "path": "AppIcon.icon", "target-membership": [ "MiniXiangqi/resources" ] },
    {
      "kind": "folder",
      "path": "MiniXiangqi",
      "target-membership": [
        "MiniXiangqi",
      ],
      "membership-exceptions": [
        {
          "target": "MiniXiangqi",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "MiniXiangqiTests", "target-membership": [ "MiniXiangqiTests" ] },
    { "kind": "folder", "path": "MiniXiangqiUITests", "target-membership": [ "MiniXiangqiUITests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Star River.app", "id": "CE259A87301668710051B648", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MiniXiangqiTests.xctest", "id": "CE259A96301668730051B648", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/MiniXiangqiUITests.xctest", "id": "CE259AA0301668730051B648", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "MiniXiangqi",
      "id": "CE259A86301668710051B648",
      "product": "Products/Star River.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Seal the engine assets",
          "input-paths": [
            "$(SRCROOT)/MiniXiangqi/Core/EngineAssets.swift",
            "$(SRCROOT)/core/assets/minixiangqi-variants.ini",
            "$(SRCROOT)/core/assets/minixiangqiaxf-ad52b8658c9e.nnue",
            "$(SRCROOT)/core/assets/xiangqi-c07e94a5c7cb.nnue",
            "$(SRCROOT)/core/assets/mix9svqfreestyle_bsmix-6bc0d1b0ff8e.bin.lz4",
            "$(SRCROOT)/core/assets/mix9svqrenju_bs15_black-7ab8c974c30d.bin.lz4",
            "$(SRCROOT)/core/assets/mix9svqrenju_bs15_white-a31f318518d3.bin.lz4",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/EngineAssets",
            "$(DERIVED_FILE_DIR)/seal-engine-assets",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/EngineAssets/minixiangqi-variants.ini",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/EngineAssets/minixiangqiaxf-ad52b8658c9e.nnue",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/EngineAssets/xiangqi-c07e94a5c7cb.nnue",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/EngineAssets/mix9svqfreestyle_bsmix-6bc0d1b0ff8e.bin.lz4",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/EngineAssets/mix9svqrenju_bs15_black-7ab8c974c30d.bin.lz4",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/EngineAssets/mix9svqrenju_bs15_white-a31f318518d3.bin.lz4",
          ],
          "shell": "/bin/sh",
          "script": [
            "set -e",
            "xcrun --sdk macosx swiftc -parse-as-library -D SEAL_ENGINE_ASSETS -o \"$SCRIPT_OUTPUT_FILE_1\" \"$SCRIPT_INPUT_FILE_0\"",
            "\"$SCRIPT_OUTPUT_FILE_1\"",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "MiniXiangqiCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
