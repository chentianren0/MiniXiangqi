# Generated by the two Windows packaging builds: windows/package-zip.ps1's
# staged distribution and its zip, and windows/package-msix.ps1's Store package,
# the tree it unpacks that package into to check it, and the LICENSE and
# NOTICE.md it writes for the payload before the build starts.
windows/dist/

# .NET build output
[Bb]in/
[Oo]bj/

# UI-test screenshot exports, regenerated by every run
.screenshots/

# Agent worktrees and session tooling live under the repo but never in it.
.claude/
